<div class="site-nav">
  <a href="/">HOME</a>
  <span class="sep">︱</span>
  <a href="/blog/" class="active">BLOG</a>
  <span class="sep">︱</span>
  <a href="/library/">LIBRARY</a>
  <span class="sep">︱</span>
  <a href="#" onclick="window.spawnRadio(); return false;">RADIO</a>
</div>

<div class="divider"></div>

<header class="page-header">
  <h1 class="page-title">TRANSMISSIONS</h1>
  <div class="page-subtitle">⌈ INTERCEPTED BROADCASTS ⌋</div>
</header>

<div class="divider"></div>

<div class="blog-list">
  {% for post in collections.posts %}
  <article class="blog-item">
    <h2 class="blog-item-title">
      <a href="{{ post.url }}">{{ post.data.title }}</a>
    </h2>
    <div class="blog-item-date">⌈ {{ post.date.toDateString() }} ⌋</div>
    {% if post.data.excerpt %}
    <p class="blog-item-excerpt">{{ post.data.excerpt }}</p>
    {% endif %}
  </article>
  {% else %}
  <p class="blog-item-excerpt">No transmissions intercepted yet...</p>
  {% endfor %}
</div>

<div class="divider"></div>

<nav class="post-nav">
  <a href="/">← RETURN TO ORIGIN</a>
</nav>

<div class="footer">est. 1918</div>
